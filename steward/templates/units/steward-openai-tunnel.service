# Generated by `steward enable openai-tunnel` (Steward {version}); `steward disable openai-tunnel` removes it.
# Outbound only: nothing listens publicly. Kill switch: systemctl --user stop steward-openai-tunnel
# The API key is not in this file: `steward service run` reads it from the Steward key files when it starts.

[Unit]
Description=OpenAI Secure MCP Tunnel for Steward
After=steward-mcp-tunnel-local.service
Requires=steward-mcp-tunnel-local.service

[Service]
Type=simple
{working_dir}
ExecStart={exec_start}
Restart=always
RestartSec=5
NoNewPrivileges=yes
UMask=0077
Environment=PYTHONUNBUFFERED=1
{environment}

[Install]
WantedBy=default.target
