# Generated by `steward enable mcp` (Steward {version}); `steward disable mcp` removes it.
# Loopback only: the server binds 127.0.0.1 and nothing else. No secret lives in this file:
# `steward service run` reads its keys from the Steward key files when it starts.

[Unit]
Description=Steward MCP server (loopback only)

[Service]
Type=simple
{working_dir}
ExecStart={exec_start}
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077
Environment=PYTHONUNBUFFERED=1
{environment}

[Install]
WantedBy=default.target
