# Generated by `steward enable tunnel` (Steward {version}); `steward disable tunnel` removes it.
# Runs your own Cloudflare named tunnel for the connector. Kill switch: systemctl --user stop steward-tunnel
# (the public URL goes dark; the local MCP server keeps running).

[Unit]
Description=Cloudflare tunnel for the Steward MCP connector
After=steward-mcp.service

[Service]
Type=simple
{working_dir}
ExecStart={exec_start}
Restart=always
RestartSec=5
NoNewPrivileges=yes
UMask=0077
Environment=PYTHONUNBUFFERED=1
{environment}

[Install]
WantedBy=default.target
