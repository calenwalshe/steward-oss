# Generated by `steward enable openai-tunnel` (Steward {version}); `steward disable openai-tunnel` removes it.
# Loopback listener for the OpenAI Secure MCP Tunnel client on this host: no auth, fixed read, steer and
# pause scopes, bound to 127.0.0.1 only. Never put it behind a public tunnel.

[Unit]
Description=Steward MCP loopback listener for the OpenAI Secure MCP Tunnel

[Service]
Type=simple
{working_dir}
ExecStart={exec_start}
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077
Environment=PYTHONUNBUFFERED=1
{environment}

[Install]
WantedBy=default.target
