# Steward MCP server + OAuth authorization server (LIVE-04).
# Binds 127.0.0.1:9520 only; public exposure is steward-tunnel.service.
# Install (chair, not a builder action):
#   ln -s <repo>/deploy/steward-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now steward-mcp
# If the repo lives elsewhere, fix ExecStart (it must point at this repo's wrapper).
# Never add EnvironmentFile=~/.api-keys (systemd drops `export` lines and
# logs the values to the journal in plaintext).

[Unit]
Description=Steward MCP server (ChatGPT connector, 127.0.0.1:9520)

[Service]
Type=simple
ExecStart=%h/work/work-20260926-135916/deploy/run-steward-mcp.sh
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
